# ============================================================
# Funções auxiliares de impressão
# Tipos de formato (fmt):
#   'cur'  → moeda com vírgula de milhar, 0 decimais
#   'cur2' → moeda com vírgula de milhar, 2 decimais
#   'dec'  → decimal com 2 casas
#   'dec4' → decimal com 4 casas (alinha com o PDF)
# ============================================================

def _formatar(valor, fmt):
    if fmt == 'cur':
        return f"{valor:,.0f}"
    elif fmt == 'cur2':
        return f"{valor:,.2f}"
    elif fmt == 'dec':
        return f"{valor:.2f}"
    elif fmt == 'dec4':
        return f"{valor:.4f}"
    return str(valor)


def imprimir_tabela(titulo, ind_2025, ind_2024, nomes_formatos):
    print(f"\n{'='*78}")
    print(f"  {titulo}")
    print(f"{'='*78}")
    print(f"{'Indicador':<42} {'2025':>16} {'2024':>16}")
    print("-" * 78)
    for chave, (nome, fmt) in nomes_formatos.items():
        v25 = _formatar(ind_2025[chave], fmt)
        v24 = _formatar(ind_2024[chave], fmt)
        print(f"{nome:<42} {v25:>16} {v24:>16}")


