# ============================================================
# SEÇÃO 6 — LUCRATIVIDADE E RENTABILIDADE
# ROE usa PL atual, ROI usa INV atual (não médios)
# ============================================================

def calcular_lucratividade(dic, ec):
    receita = dic['receita_liquida']

    margem_bruta = dic['lucro_bruto'] / receita
    ebitda = dic['ebitda']
    margem_ebitda = ebitda / receita
    ebit = dic['ebit']
    margem_ebit = ebit / receita
    nopat = dic['nopat']
    margem_nopat = nopat / receita
    margem_liquida = dic['lucro_liquido'] / receita

    roi = nopat / ec['investimento']
    roe = dic['lucro_liquido'] / dic['pl']
    gaf = roe / roi if roi != 0 else 0       # Grau de Alavancagem Financeira

    return {
        'margem_bruta': margem_bruta,
        'ebitda': ebitda,
        'margem_ebitda': margem_ebitda,
        'ebit': ebit,
        'margem_ebit': margem_ebit,
        'nopat': nopat,
        'margem_nopat': margem_nopat,
        'margem_liquida': margem_liquida,
        'roi': roi,
        'roe': roe,
        'gaf': gaf,
    }

