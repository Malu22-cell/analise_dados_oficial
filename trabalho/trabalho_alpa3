# ============================================================
# SEÇÃO 5 — CUSTO DO CAPITAL (CMPC / WACC)
# ============================================================

def calcular_custo_capital(dic, ec, aliquota, ke):
    po = ec['passivo_oneroso']
    inv = ec['investimento']
    pl = dic['pl']
    df_bruta = dic['despesa_financeira']
    ir_corrente = dic['ir_corrente']
    lair = dic['lair']

    wi = po / inv                                      # % da Dívida no INV
    we = pl / inv                                      # % do Equity no INV
    aliq_efetiva = ir_corrente / lair if lair != 0 else 0
    bt = df_bruta * aliquota                           # Benefício Tributário (alíq. estatutária)
    dfl = df_bruta - bt                                # Despesa Financeira Líquida
    ki = df_bruta / po                                 # Custo da Dívida (bruto)
    ki_apos = ki * (1 - aliquota)                      # Ki após impostos
    wacc = wi * ki_apos + we * ke                      # CMPC

    return {
        'wi': wi,
        'we': we,
        'aliq_efetiva': aliq_efetiva,
        'df_bruta': df_bruta,
        'bt': bt,
        'dfl': dfl,
        'ki': ki,
        'ki_apos': ki_apos,
        'wacc': wacc,
    }

