# ============================================================
# SEÇÃO 2 — INDICADORES DE ATIVIDADE E CICLOS
# Usa médias entre o saldo do ano anterior e do ano atual.
# Prazos calculados em 360 dias.
# ============================================================

def calcular_atividade(dic_atual, dic_anterior):
    # Médias (saldo inicial + saldo final) / 2
    estoque_medio = (dic_anterior['estoque'] + dic_atual['estoque']) / 2
    cr_medio = (dic_anterior['contas_receber'] + dic_atual['contas_receber']) / 2
    forn_medio = (dic_anterior['fornecedores'] + dic_atual['fornecedores']) / 2

    cmv = dic_atual['cmv']
    receita = dic_atual['receita_liquida']

    # Compras = CMV + (Estoque Final - Estoque Inicial)
    compras = cmv + (dic_atual['estoque'] - dic_anterior['estoque'])

    # Prazos médios (× 360)
    pme = (estoque_medio / cmv) * 360
    giro_estoque = 360 / pme
    pmrv = (cr_medio / receita) * 360
    pmpf = (forn_medio / compras) * 360

    # Ciclos
    co = pme + pmrv      # Ciclo Operacional
    cf = co - pmpf       # Ciclo Financeiro
    ciclo_economico = pme

    # Decomposição do Ativo e Passivo Circulante
    acf = dic_atual['caixa_equivalentes']                  # ACF
    aco = dic_atual['ativo_circ'] - acf                    # ACO
    ac = dic_atual['ativo_circ']                           # AC
    pcf = dic_atual['divida_cp']                           # PCF
    pco = dic_atual['passivo_circ'] - pcf                  # PCO
    pc = dic_atual['passivo_circ']                         # PC

    st = acf - pcf       # Saldo de Tesouraria
    ncg = aco - pco      # Necessidade de Capital de Giro
    cgl = ac - pc        # Capital de Giro Líquido (= CCL)

    return {
        'pme': pme,
        'giro_estoque': giro_estoque,
        'pmrv': pmrv,
        'compras': compras,
        'pmpf': pmpf,
        'co': co,
        'cf': cf,
        'ciclo_economico': ciclo_economico,
        'acf': acf,
        'aco': aco,
        'ac': ac,
        'pcf': pcf,
        'pco': pco,
        'pc': pc,
        'st': st,
        'ncg': ncg,
        'cgl': cgl,
    }

