# SEÇÃO 8 — MÚLTIPLOS DE MERCADO (apenas 2025)
# Valores em milhares de R$ convertidos para R$ (× 1000)
# ============================================================

def calcular_multiplos(dic, lucr, ec, n_acoes, preco_atual, preco_inicio, dpa):
    # Converter valores contábeis para R$ unitários
    pl_R = dic['pl'] * 1000
    ll_R = dic['lucro_liquido'] * 1000
    receita_R = dic['receita_liquida'] * 1000
    ebitda_R = lucr['ebitda'] * 1000
    dl_R = ec['divida_liquida'] * 1000

    vpa = pl_R / n_acoes
    pvp = preco_atual / vpa
    lpa = ll_R / n_acoes
    pl_ratio = preco_atual / lpa
    market_cap = n_acoes * preco_atual
    price_to_book = market_cap / pl_R
    dtp = dpa * n_acoes
    dy = dpa / preco_atual
    payout = dpa / lpa
    delta_preco = preco_atual - preco_inicio
    retorno_capital = delta_preco / preco_inicio
    tra = (dpa + delta_preco) / preco_inicio
    ev = market_cap + dl_R
    ev_ebitda = ev / ebitda_R
    ev_receita = ev / receita_R
    earning_yield = ebitda_R / ev

    return {
        'n_acoes': n_acoes,
        'vpa': vpa,
        'preco_atual': preco_atual,
        'pvp': pvp,
        'lpa': lpa,
        'pl_ratio': pl_ratio,
        'market_cap': market_cap,
        'price_to_book': price_to_book,
        'dpa': dpa,
        'dtp': dtp,
        'dy': dy,
        'payout': payout,
        'delta_preco': delta_preco,
        'retorno_capital': retorno_capital,
        'tra': tra,
        'ev': ev,
        'ev_ebitda': ev_ebitda,
        'ev_receita': ev_receita,
        'earning_yield': earning_yield,
    }

mult_2025 = calcular_multiplos(dic_2025, lucr_2025, ec_2025, n_acoes, preco_atual, preco_inicio, dpa)

imprimir_tabela_unica('SEÇÃO 8 — MÚLTIPLOS DE MERCADO', mult_2025, {
    'n_acoes': ('Nº de ações (ON + PN)', 'cur'),
    'vpa': ('VPA (PL / Nº ações)', 'dec4'),
