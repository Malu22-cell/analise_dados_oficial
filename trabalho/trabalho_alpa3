# SEÇÃO 7 — VALOR AGREGADO (EVA)
# ============================================================

def calcular_valor_agregado(ec, lucr, cc):
    roi = lucr['roi']
    wacc = cc['wacc']
    inv = ec['investimento']

    eva = (roi - wacc) * inv                  # Valor Econômico Adicionado
    rroi = roi - wacc                         # ROI Residual
    goodwill = eva / wacc if wacc != 0 else 0

    return {
        'eva': eva,
        'rroi': rroi,
        'goodwill': goodwill,
