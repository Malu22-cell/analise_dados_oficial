# Função para extrair todas as contas contábeis do balanço
# ============================================================

def encontrar_contas_contabeis(df):
    # Ativo Circulante
    ativo_circ = float(df[df["conta"]=='1.01']['valor'].iloc[0])

    # Passivo Circulante
    passivo_circ = float(df[df["conta"]=='2.01']['valor'].iloc[0])

    # Passivo Não Circulante
    passivo_n_circ = float(df[df["conta"]=='2.02']['valor'].iloc[0])

    # Intangível (1.02.04)
    filtro = df["descricao"].str.contains('intang.vel', case=False) & (df["conta"]=='1.02.04')
    intangivel = float(df[filtro]['valor'].iloc[0])

    # Imobilizado (1.02.03)
    filtro = df["descricao"].str.contains('imobilizado', case=False) & df["conta"].str.contains('1.02.03', case=False)
    imobilizado = float(df[filtro]['valor'].iloc[0])

    # Investimento (1.02.02)
    filtro = df["descricao"].str.contains('investimento', case=False) & df["conta"].str.contains('1.02.02', case=False)
    investimento = float(df[filtro]['valor'].iloc[0])

    # Realizável a Longo Prazo (1.02.01)
    rlp = float(df[df["conta"]=='1.02.01']['valor'].iloc[0])

    # Estoque
    estoque = float(df[df["descricao"].str.contains('estoque', case=False)]['valor'].iloc[0])

    # Despesa antecipada
    filtro = df["descricao"].str.contains('despesa', case=False) & df["conta"].str.contains('1.01.07', case=False)
    despesa_antecipada = float(df[filtro]['valor'].iloc[0])

    # Caixa e equivalentes
    filtro = df["descricao"].str.contains('caixa.*equivalentes', case=False) & df["conta"].str.contains('1.*', case=False)
    caixa_equivalentes = float(df[filtro]['valor'].iloc[0])

    # CMV (magnitude)
    filtro = df["descricao"].str.contains('custo.*bens', case=False) & df["conta"].str.contains('3.*', case=False)
    cmv = abs(float(df[filtro]['valor'].iloc[0]))

    # PL (Patrimônio Líquido)
    pl = float(df[df["conta"]=='2.03']['valor'].iloc[0])

    # Ativo Total
    ativo_total = float(df[df["conta"]=='1']['valor'].iloc[0])

    # Passivo Total (PC + PNC)
    passivo_total = passivo_circ + passivo_n_circ

    # Contas a Receber
    filtro = df["descricao"].str.contains('clientes|receb', case=False) & df["conta"].str.contains('1.01.03', case=False)
    contas_receber = float(df[filtro]['valor'].iloc[0])

    # Fornecedores (magnitude)
    filtro = df["descricao"].str.contains('fornecedor', case=False) & df["conta"].str.contains('2.01.02', case=False)
    fornecedores = abs(float(df[filtro]['valor'].iloc[0]))

    # Dívida Financeira CP (2.01.04)
    filtro = df["descricao"].str.contains('empr.stimo|financiamento', case=False) & df["conta"].str.contains('2.01.04', case=False)
    divida_cp = abs(float(df[filtro]['valor'].iloc[0]))

    # Dívida Financeira LP (2.02.01)
    filtro = df["descricao"].str.contains('empr.stimo|financiamento', case=False) & df["conta"].str.contains('2.02.01', case=False)
    divida_lp = abs(float(df[filtro]['valor'].iloc[0]))

    # Receita Líquida (3.01)
    receita_liquida = float(df[df["conta"]=='3.01']['valor'].iloc[0])

    # Lucro Bruto (3.03)
    lucro_bruto = float(df[df["conta"]=='3.03']['valor'].iloc[0])

    # EBIT (3.05)
    ebit = float(df[df["conta"]=='3.05']['valor'].iloc[0])

    # LAIR / EBT (3.07) — Lucro Antes do IR
    lair = float(df[df["conta"]=='3.07']['valor'].iloc[0])

    # IR/CSLL Corrente (3.08.01)
    ir_corrente = float(df[df["conta"]=='3.08.01']['valor'].iloc[0])

    # Lucro Líquido (3.11)
    lucro_liquido = float(df[df["conta"]=='3.11']['valor'].iloc[0])

    # NOPAT = EBIT - IR/CSLL corrente
    nopat = ebit - ir_corrente

    # Despesa Financeira Bruta (3.06.02, magnitude)
    despesa_financeira = abs(float(df[df["conta"]=='3.06.02']['valor'].iloc[0]))

    # Depreciação & Amortização (DVA - conta 7.04.01, magnitude)
    depreciacao_amortizacao = abs(float(df[df["conta"]=='7.04.01']['valor'].iloc[0]))

    # EBITDA = EBIT + D&A
    ebitda = ebit + depreciacao_amortizacao

    return {
        'ativo_circ': ativo_circ,
        'passivo_circ': passivo_circ,
        'passivo_n_circ': passivo_n_circ,
        'intangivel': intangivel,
        'imobilizado': imobilizado,
        'investimento': investimento,
        'rlp': rlp,
        'estoque': estoque,
        'despesa_antecipada': despesa_antecipada,
        'caixa_equivalentes': caixa_equivalentes,
        'cmv': cmv,
        'pl': pl,
        'ativo_total': ativo_total,
        'passivo_total': passivo_total,
        'contas_receber': contas_receber,
        'fornecedores': fornecedores,
        'divida_cp': divida_cp,
        'divida_lp': divida_lp,
        'receita_liquida': receita_liquida,
        'lucro_bruto': lucro_bruto,
        'ebit': ebit,
        'lair': lair,
        'ir_corrente': ir_corrente,
        'nopat': nopat,
        'lucro_liquido': lucro_liquido,
        'despesa_financeira': despesa_financeira,
        'depreciacao_amortizacao': depreciacao_amortizacao,
        'ebitda': ebitda,
    }


