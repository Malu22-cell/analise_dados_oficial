def calcular_estrutura_complementar(dic):
    # Passivo Oneroso = Empréstimos/Financiamentos (CP + LP)
    passivo_oneroso = dic['divida_cp'] + dic['divida_lp']
    # Dívida Líquida = PO - Caixa/Equivalentes
    divida_liquida = passivo_oneroso - dic['caixa_equivalentes']
    # Investimento = PO + PL
    investimento = passivo_oneroso + dic['pl']
    # Capital Oneroso = DL + PL
    capital_oneroso = divida_liquida + dic['pl']

    dl_sobre_pl = divida_liquida / dic['pl']
    dl_sobre_co = divida_liquida / capital_oneroso

    return {
        'passivo_oneroso': passivo_oneroso,
        'divida_liquida': divida_liquida,
        'investimento': investimento,
        'capital_oneroso': capital_oneroso,
        'dl_sobre_pl': dl_sobre_pl,
        'dl_sobre_co': dl_sobre_co,
    }

